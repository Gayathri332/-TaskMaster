PORT=3000
NODE_ENV=development
# REQUIRED in production - use a long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
DB_PATH=./data/taskmaster.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ---- Optional: generative AI (pick ONE provider; leave all blank to use the built-in template) ----
# AI_PROVIDER=openrouter        # openrouter | cohere | anthropic  (auto-detected if omitted)

# OpenRouter (free models available) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated list: tried in order until one works. Free model names change - see https://openrouter.ai/models?q=free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-20b:free,google/gemma-3-27b-it:free

# Cohere (free trial key) - https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024

# Anthropic (paid) - https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
